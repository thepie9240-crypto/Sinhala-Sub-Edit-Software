{
  "name": "subtitle-editor",
  "version": "25.0.0",
  "description": "Subtitle Editor V25",
  "main": "main.js",
  "author": "Subtitle Editor",
  "scripts": {
    "build": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.subtitle.editor",
    "productName": "SubtitleEditor",
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html"
    ],
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
